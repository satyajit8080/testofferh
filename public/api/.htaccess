# API responses are per-user / dynamic: never cache at the browser or Cloudflare edge.
<IfModule mod_headers.c>
  Header always set Cache-Control "no-store, private"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>
Options -Indexes

# Chat assistant: secrets, shared helpers and Composer files are never served.
<FilesMatch "^(config\.local\.php|common\.php|composer\.(json|lock))$">
  Require all denied
</FilesMatch>

RedirectMatch 404 ^/api/(vendor|storage)(/|$)
